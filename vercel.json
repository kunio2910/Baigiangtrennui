{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/home-page.js": {
      "includeFiles": "index.html"
    },
    "api/detail-page.js": {
      "includeFiles": "detail.html"
    },
    "api/category-page.js": {
      "includeFiles": "category.html"
    }
  },
  "routes": [
    {
      "src": "^/gop-y\\.html$",
      "headers": {
        "Location": "/gop-y"
      },
      "status": 308
    },
    {
      "src": "^/index\\.html$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "dest": "/api/home-page"
    },
    {
      "src": "^/gop-y$",
      "dest": "/gop-y.html"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/cac-thanh$",
      "dest": "/api/category-page?type=saints"
    },
    {
      "src": "^/nha-tho$",
      "dest": "/api/category-page?type=churches"
    },
    {
      "src": "^/bai-viet$",
      "dest": "/api/category-page?type=articles"
    },
    {
      "src": "^/su-kien$",
      "dest": "/api/category-page?type=events"
    },
    {
      "src": "^/cau-nguyen$",
      "dest": "/api/category-page?type=prayers"
    },
    {
      "src": "^/giao-ly$",
      "dest": "/api/category-page?type=catechism"
    },
    {
      "src": "^/gui-loi-cau-nguyen$",
      "dest": "/prayer-request.html"
    },
    {
      "src": "^/kham-pha-duc-tin$",
      "dest": "/faith-discovery.html"
    },
    {
      "src": "^/hanh-trinh-kinh-thanh$",
      "dest": "/hanh-trinh-kinh-thanh-test.html"
    },
    {
      "src": "^/cac-thanh/([^/]+)$",
      "dest": "/api/detail-page?type=saints&slug=$1"
    },
    {
      "src": "^/nha-tho/([^/]+)$",
      "dest": "/api/detail-page?type=churches&slug=$1"
    },
    {
      "src": "^/bai-viet/([^/]+)$",
      "dest": "/api/detail-page?type=articles&slug=$1"
    },
    {
      "src": "^/su-kien/([^/]+)$",
      "dest": "/api/detail-page?type=events&slug=$1"
    },
    {
      "src": "^/cau-nguyen/([^/]+)$",
      "dest": "/api/detail-page?type=prayers&slug=$1"
    },
    {
      "src": "^/giao-ly/([^/]+)$",
      "dest": "/api/detail-page?type=catechism&slug=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
